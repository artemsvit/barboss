{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "barboss-landing",
  "compatibility_date": "2024-09-01",
  "assets": {
    "directory": "./landing"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true
    }
  },
  "routes": [
    {
      "pattern": "barboss.artsvit.com",
      "custom_domain": true
    }
  ]
}
